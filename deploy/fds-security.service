[Unit]
Description=FDS security alert monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workspace/fds-project
EnvironmentFile=/home/ubuntu/.config/fds/fds.env
ExecStart=/home/ubuntu/workspace/fds-project/.venv/bin/uvicorn app.security:app --host 127.0.0.1 --port 5001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
